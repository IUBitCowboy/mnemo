# mnemo_config.example — Copy to ~/.mnemo_config (global) or .mnemo_config (project).
# Local (.mnemo_config) overrides global (~/.mnemo_config).
# Both are optional. Do not commit either to version control.

# ── Python / tool paths ───────────────────────────────────────────────────────
# Override if your venv is not at mnemo/.venv/
# MNEMO_PYTHON="/Users/yourname/devops/teaching/SE1/mnemo/.venv/bin/python"
# MNEMO_CHAT_SCRIPT="/Users/yourname/devops/teaching/SE1/mnemo/tools/chat.py"

# ── Provider defaults ─────────────────────────────────────────────────────────
MNEMO_PROVIDER="anthropic"
# MNEMO_MODEL="claude-sonnet-4-6"   # leave blank to use provider default

# ── Sessions output directory ─────────────────────────────────────────────────
# Set this in the project-level .mnemo_config, relative to where you source it.
MNEMO_SESSIONS_DIR="./sessions/"

# ── Persona aliases ───────────────────────────────────────────────────────────
# Define aliases used by: chat with <name>
# MNEMO_PERSONA_CLIO="/Users/yourname/devops/teaching/SE1/mnemo/Clio/clio_base.md"
# MNEMO_PERSONA_CALLIOPE="/Users/yourname/devops/teaching/SE1/mnemo/Calliope/calliope_persona_v2.md"

# ── Focus mode default ────────────────────────────────────────────────────────
# "off" = conversational/chat mode  |  "on" = full artifact generation
MNEMO_FOCUS="off"

# ── Provider layer scope ──────────────────────────────────────────────────────
# Controls how many artifact layers are assembled into the system prompt at launch.
# "*"       = assemble all discovered layers (good for large-context cloud models)
# "focused" = use only the explicitly selected MNEMO_ARTIFACT_LAYER (good for local models)
# These are the built-in defaults — uncomment to override:
# MNEMO_LAYER_SCOPE_ANTHROPIC="*"
# MNEMO_LAYER_SCOPE_GEMINI="*"
# MNEMO_LAYER_SCOPE_OLLAMA="focused"

# ── API key references (1Password op CLI) ─────────────────────────────────────
# Used by: access anthropic / access gemini
# Format:  op://VaultName/ItemName/field
# Never commit these values. Keep in ~/.mnemo_config only.
# MNEMO_OP_ANTHROPIC="op://VaultName/Anthropic API Key/credential"
# MNEMO_OP_GEMINI="op://VaultName/Gemini API Key/credential"
